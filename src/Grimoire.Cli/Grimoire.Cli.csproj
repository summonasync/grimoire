<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>grimoire</ToolCommandName>
    <PackageId>Grimoire</PackageId>
    <Description>Local agent memory service: MCP stdio face, web console and CLI.</Description>
    <PackageTags>memory;mcp;agent;qdrant</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grimoire.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grimoire.Api\Grimoire.Api.csproj" />
    <ProjectReference Include="..\Grimoire.Infrastructure\Grimoire.Infrastructure.csproj" />
    <ProjectReference Include="..\Grimoire.Mcp\Grimoire.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>

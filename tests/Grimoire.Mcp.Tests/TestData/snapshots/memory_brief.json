{
  "contract": {
    "description": "Load the session-start payload in one call: persona, top-scored facts, recent journal, the tombstone digest, and the startup contract block in hint - read it here once instead of chaining persona_get, recall and list. Sections fill in priority order under a char budget, journal bodies are capped per entry and flagged truncated, and what no longer fits is named in omitted; state empty is cold start, not failure.",
    "destructive": false,
    "idempotent": true,
    "input": {
      "parameters": {
        "factsPerScope": {
          "default": null,
          "type": [
            "integer",
            "null"
          ]
        },
        "journalPerScope": {
          "default": null,
          "type": [
            "integer",
            "null"
          ]
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        },
        "tombstoneLimit": {
          "default": null,
          "type": [
            "integer",
            "null"
          ]
        },
        "tome": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "name": "memory_brief",
    "readOnly": true,
    "title": "Get the startup brief"
  },
  "output": {
    "facts": {
      "items": {
        "arrayOf": {
          "content": "string",
          "createdAt": "string",
          "memoryId": "string",
          "scope": "string",
          "score": "number"
        }
      },
      "state": "string"
    },
    "hint": "string",
    "journal": {
      "items": {
        "arrayOf": {
          "content": "string",
          "createdAt": "string",
          "memoryId": "string",
          "scope": "string",
          "truncated": "boolean"
        }
      },
      "state": "string"
    },
    "omitted": {
      "arrayOf": "string"
    },
    "persona": {
      "state": "string"
    },
    "tombstones": {
      "items": {
        "arrayOf": {
          "memoryId": "string",
          "reason": "string",
          "tombstonedAt": "string"
        }
      },
      "state": "string"
    },
    "tome": "string"
  }
}

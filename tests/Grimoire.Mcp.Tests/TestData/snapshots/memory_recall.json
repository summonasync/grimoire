{
  "contract": {
    "description": "Search memory before you assume - ranked semantic matches over the active records of one tome; superseded and tombstoned never surface, and a read bumps the record's access stats. Call it when prior context could change the answer; narrow with scope, projectId, tags or the since/until/actor filters before raising limit, and pass tome to read another tome you own, memory_scry answers across tomes.",
    "destructive": false,
    "idempotent": true,
    "input": {
      "parameters": {
        "actor": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 5,
          "type": "integer"
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "scope": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        },
        "tome": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "name": "memory_recall",
    "readOnly": true,
    "title": "Recall memories"
  },
  "output": {
    "count": "number",
    "matches": {
      "arrayOf": {
        "actor": "string",
        "content": "string",
        "createdAt": "string",
        "kind": "string",
        "lastAccessedAt": "string",
        "memoryId": "string",
        "projectId": "string",
        "scope": "string",
        "score": "number",
        "similarity": "number",
        "tags": {
          "arrayOf": "string"
        }
      }
    },
    "tome": "string"
  }
}

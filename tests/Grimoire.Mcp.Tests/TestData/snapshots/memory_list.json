{
  "contract": {
    "description": "Browse stored memories by filter, newest first - full records, Active by default, with status, actor and tags; pass status to audit Superseded or Tombstoned rows, for example to confirm a Fact was already retracted. Prefer memory_recall for meaning-based lookup; reads are tome-scoped and the response echoes the tome listed.",
    "destructive": false,
    "idempotent": true,
    "input": {
      "parameters": {
        "kind": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "type": "integer"
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "default": "Active",
          "type": "string"
        },
        "tags": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        },
        "tome": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "name": "memory_list",
    "readOnly": true,
    "title": "List memories"
  },
  "output": {
    "count": "number",
    "memories": {
      "arrayOf": {
        "accessCount": "number",
        "actor": "string",
        "bodyChars": "number",
        "content": "string",
        "createdAt": "string",
        "importance": "number",
        "kind": "string",
        "lastAccessedAt": "string",
        "memoryId": "string",
        "projectId": "string",
        "scope": "string",
        "status": "string",
        "tags": {
          "arrayOf": "string"
        }
      }
    },
    "tome": "string"
  }
}

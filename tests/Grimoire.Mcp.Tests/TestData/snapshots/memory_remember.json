{
  "contract": {
    "description": "Write a durable memory and get back the stored record - id, tome, scope, kind and supersede outcome - with your actor provenance on it. The door for durable facts in English and explicit corrections via supersedes: keep the human's verbatim quotes as spoken and never store secrets. When nearDuplicates come back, re-remember with supersedes set to the older memoryId instead of keeping both. Casual, low-ceremony notes belong to memory_note.",
    "destructive": false,
    "idempotent": false,
    "input": {
      "parameters": {
        "content": {
          "type": "string"
        },
        "importance": {
          "default": 0.5,
          "type": "number"
        },
        "kind": {
          "default": "Journal",
          "type": "string"
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "sessionId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        },
        "tome": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "scope"
      ]
    },
    "name": "memory_remember",
    "readOnly": false,
    "title": "Remember a memory"
  },
  "output": {
    "actor": "string",
    "bodyChars": "number",
    "createdAt": "string",
    "idempotentReplay": "boolean",
    "kind": "string",
    "maintenancePending": "boolean",
    "memoryId": "string",
    "nearDuplicates": {
      "arrayOf": {
        "memoryId": "string",
        "similarity": "number",
        "snippet": "string"
      }
    },
    "projectId": "string",
    "scope": "string",
    "supersededExisting": "boolean",
    "tags": {
      "arrayOf": "string"
    },
    "tome": "string"
  }
}

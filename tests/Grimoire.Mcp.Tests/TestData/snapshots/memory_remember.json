{
  "contract": {
    "description": "Write a durable memory and get back the stored record - id, tome, scope, kind and supersede outcome - with your actor provenance on it. Call it when the human states a preference, decision or correction and record it verbatim; a near-duplicate supersedes the older record, an identical write replays it, and never store secrets.",
    "destructive": false,
    "idempotent": false,
    "input": {
      "parameters": {
        "content": {
          "type": "string"
        },
        "importance": {
          "default": 0.5,
          "type": "number"
        },
        "kind": {
          "default": "Journal",
          "type": "string"
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "sessionId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        },
        "tome": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "scope"
      ]
    },
    "name": "memory_remember",
    "readOnly": false,
    "title": "Remember a memory"
  },
  "output": {
    "actor": "string",
    "bodyChars": "number",
    "createdAt": "string",
    "idempotentReplay": "boolean",
    "kind": "string",
    "maintenancePending": "boolean",
    "memoryId": "string",
    "projectId": "string",
    "scope": "string",
    "supersededExisting": "boolean",
    "tags": {
      "arrayOf": "string"
    },
    "tome": "string"
  }
}

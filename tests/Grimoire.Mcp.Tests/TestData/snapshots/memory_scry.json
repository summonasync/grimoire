{
  "contract": {
    "description": "Read into OTHER tomes - the one deliberate cross-tome surface; the only trace is an access bump on the records it surfaces, never a new row in your tome. Facts alone unless includeJournal opts in; session rows never cross, superseded and tombstoned never surface, and hits stay anonymous until attribution lifts the provenance veil.",
    "destructive": false,
    "idempotent": true,
    "input": {
      "parameters": {
        "attribution": {
          "default": "None",
          "type": "string"
        },
        "includeJournal": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "default": 5,
          "type": "integer"
        },
        "query": {
          "type": "string"
        },
        "tomes": {
          "default": null,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "name": "memory_scry",
    "readOnly": true,
    "title": "Scry other tomes"
  },
  "output": {
    "attribution": "string",
    "count": "number",
    "hits": {
      "arrayOf": {
        "content": "string",
        "createdAt": "string",
        "kind": "string",
        "matchedTerms": {
          "arrayOf": {
            "field": "string",
            "start": "number",
            "term": "string"
          }
        },
        "memoryId": "string",
        "scope": "string",
        "score": "number",
        "similarity": "number",
        "tags": {
          "arrayOf": "string"
        },
        "tome": "string"
      }
    },
    "tomes": {
      "arrayOf": "string"
    }
  }
}
